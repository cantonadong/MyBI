  "dependencies": {
    "echarts": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "22.1.0",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  }
