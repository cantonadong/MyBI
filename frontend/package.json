{
  "name": "data-workbench-web",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test": "vitest --config vite.config.ts",
    "typecheck": "tsc -b --pretty false"
