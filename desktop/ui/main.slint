import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

component CompactButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    width: max(88px, measure.preferred-width + 24px);
    horizontal-stretch: 0;
    forward-focus: control;
    measure := Text { visible: false; text: root.text; font-size: 12px; }
    control := Button {
        width: 100%; height: 100%;
        text: root.text; enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ManagerWindow inherits Window {
    title: "MyBI";
    icon: @image-url("../../design/icon.png");
    preferred-width: 540px;
    preferred-height: 360px;
    min-width: 500px;
    min-height: 340px;
    background: #f4f6fa;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    in property <string> heading;
    in property <string> status-text;
    in property <string> start-text;
    in property <string> stop-text;
    in property <string> open-text;
    in property <string> close-hint;
    in property <string> logs-text;
    in property <string> error-text;
    in property <bool> running;
    in-out property <bool> busy: true;
    callback start-service();
    callback stop-service();
    callback open-report();

    VerticalBox {
        padding: 22px;
        spacing: 14px;
        HorizontalBox {
            spacing: 12px;
            Image { source: @image-url("../../design/icon.png"); width: 38px; height: 38px; }
            VerticalBox {
                padding: 0px; spacing: 3px;
                Text { text: "MyBI"; color: #202738; font-size: 20px; font-weight: 700; }
                Text { text: root.heading; color: #697286; }
            }
        }
        Rectangle {
            background: #fff; border-color: #e0e5ed; border-width: 1px; border-radius: 8px;
            height: 76px;
            VerticalBox {
                padding: 14px; spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.running ? #1e9e7b : root.busy ? #5969f4 : #8790a4; }
                    Text { text: root.status-text; color: #202738; font-weight: 600; }
                }
                Text { text: "http://127.0.0.1:8000"; color: #697286; }
            }
        }
        HorizontalBox {
            spacing: 8px;
            CompactButton { text: root.start-text; enabled: !root.busy && !root.running; clicked => { root.start-service(); } }
            CompactButton { text: root.stop-text; enabled: !root.busy && root.running; clicked => { root.stop-service(); } }
            CompactButton { text: root.open-text; enabled: !root.busy && root.running; clicked => { root.open-report(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.error-text != "": ScrollView {
            Text { text: root.error-text; color: #b42318; wrap: word-wrap; }
        }
        if root.error-text == "": Rectangle { vertical-stretch: 1; }
        Text { text: root.close-hint; color: #697286; wrap: word-wrap; }
        Text { text: root.logs-text; color: #8790a4; wrap: word-wrap; font-size: 11px; }
    }
}
